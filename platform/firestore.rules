// Firestore security rules for the narrative-studio-backend project (shared by every Walsh Classroom app).
//
// LIVE since Nov 13 2026 (Phase 3), published in the Firebase console. Keep this file in
// step with the console: a change here does nothing until it is published there.
// The Phase 2 version is in git history (commit e8b2a4d).
//
// Phase 2: roles are protected (a confirmed .org/.edu email or an invite code makes a
// teacher; only admins promote; only the master sets "master"); invite codes, comment
// templates and teacher tips have rules; teachers make their own classrooms.
//
// Phase 3:
//   1. Teacher access records (classAccess): a class's teacher can read their students'
//      work in every app, and comment on it. Before, only Tom's account could.
//   2. Rosters are teacher-only: students can't list a class's members any more.
//   3. classrooms/{id}/shared: the projects students share with their class, readable
//      by the class, so classmate sharing no longer needs the roster.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Who's asking ─────────────────────────────────────────────
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    // Tom's account. The root of trust: it can't be granted or taken away by a profile edit.
    function isMaster() { return signedIn() && me() == 'vCXND7JhhscwvGoWS4kztBBDmbk2'; }
    function profilePath(uid) { return /databases/$(database)/documents/users/$(uid)/profile/main; }
    function myProfile() { return get(profilePath(me())).data; }
    function hasProfile() { return signedIn() && exists(profilePath(me())); }
    function isAdmin() { return isMaster() || (hasProfile() && myProfile().get('isAdmin', false) == true); }
    function isTeacher() { return isAdmin() || (hasProfile() && myProfile().get('role', 'student') == 'teacher'); }
    // A school email that its owner has confirmed by clicking Firebase's link.
    function confirmedTeacherEmail() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*[.](org|edu)$');
    }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // ── Profiles: users/{uid}/profile/main ───────────────────────
    match /users/{uid}/profile/{docId} {
      allow read: if signedIn() && (me() == uid || isTeacher());

      // Your own profile, on first sign-in. You start as a student, or as a teacher
      // if your .org/.edu email is confirmed. Never admin or master.
      allow create: if signedIn() && me() == uid
        && request.resource.data.get('isAdmin', false) == false
        && request.resource.data.get('isMaster', false) == false
        && (request.resource.data.get('role', 'student') == 'student'
            || (request.resource.data.role == 'teacher' && confirmedTeacherEmail()));

      // Your own profile, later. Change anything except your role, unless you're
      // becoming a teacher with a confirmed school email or an invite code you
      // redeem in the same write.
      allow update: if signedIn() && me() == uid
        && !changed().hasAny(['isAdmin', 'isMaster'])
        && (!changed().hasAny(['role'])
            || (request.resource.data.role == 'teacher' && (confirmedTeacherEmail() || redeemsInvite())));

      // Admins manage other people's roles. Only the master can make or unmake a master.
      allow create, update: if isAdmin()
        && (request.resource.data.get('isMaster', false) == false || isMaster())
        && (uid != 'vCXND7JhhscwvGoWS4kztBBDmbk2' || isMaster());

      allow delete: if isMaster();
    }

    // The invite code named in the profile write is marked used by you in the same batch,
    // and it wasn't used before.
    function redeemsInvite() {
      let code = request.resource.data.get('inviteCode', '');
      let path = /databases/$(database)/documents/teacherInviteCodes/$(code);
      return code is string && code != ''
        && exists(path)
        && get(path).data.usedBy == null
        && getAfter(path).data.usedBy == me();
    }

    // ── Everything else in a user's folder (projects, scenes, documents, pins…) ──
    match /users/{uid}/{col}/{rest=**} {
      allow read, write: if signedIn() && me() == uid && col != 'profile';
      // Tom can read any student workspace.
      allow read: if isMaster();
      // A teacher can read the work of a student in one of their classes (Phase 3).
      allow read: if col != 'profile' && teachesStudent(uid);
      // Classmates can read projects marked shared:true (unchanged).
      allow read: if signedIn() && col != 'profile' && resource != null && resource.data.get('shared', false) == true;
    }

    // ── Teacher invite codes ─────────────────────────────────────
    match /teacherInviteCodes/{code} {
      // Redeeming looks a code up directly; only admins can list them.
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.issuedBy == me()
        && request.resource.data.usedBy == null;
      // Redeem: mark an unused, unexpired code as used by you. Nothing else changes.
      allow update: if signedIn()
        && resource.data.usedBy == null
        && resource.data.expiresAt > request.time
        && request.resource.data.usedBy == me()
        && changed().hasOnly(['usedBy', 'usedAt']);
      allow delete: if isAdmin();
    }

    // ── Teacher access records (Phase 3) ─────────────────────────
    // classAccess/{teacherUid}_{studentUid} means "this teacher may read this student's work".
    // A student writes it when they join one of the teacher's classes; it goes when they
    // leave or are removed. One record per teacher and student, however many classes.
    function teachesStudent(studentUid) {
      return signedIn() && exists(/databases/$(database)/documents/classAccess/$(me() + '_' + studentUid));
    }
    function classPath(id) { return /databases/$(database)/documents/classrooms/$(id); }
    function memberPath(id, uid) { return /databases/$(database)/documents/classrooms/$(id)/members/$(uid); }

    match /classAccess/{key} {
      // Looking up a record that doesn't exist just says "not found"; existing ones are private.
      allow get: if signedIn() && (resource == null || resource.data.teacherUid == me() || resource.data.studentUid == me() || isMaster());
      allow list: if signedIn() && (resource.data.teacherUid == me() || resource.data.studentUid == me() || isMaster());
      // The student, for a class they're already in, that this teacher really teaches.
      // (Joining saves the membership first, then this record.)
      allow create, update: if signedIn()
        && request.resource.data.studentUid == me()
        && key == request.resource.data.teacherUid + '_' + me()
        && get(classPath(request.resource.data.classroomId)).data.teacherUid == request.resource.data.teacherUid
        && exists(memberPath(request.resource.data.classroomId, me()));
      allow delete: if signedIn() && (resource.data.studentUid == me() || resource.data.teacherUid == me() || isMaster());
    }

    // ── Classrooms ───────────────────────────────────────────────
    match /classrooms/{classroomId} {
      function myClassroom() { return resource.data.teacherUid == me(); }
      function teachesThis() { return get(classPath(classroomId)).data.teacherUid == me(); }
      function inThis() { return exists(memberPath(classroomId, me())); }
      // Anyone signed in can read classrooms (needed to join by code).
      allow read: if signedIn();
      // Teachers make their own; Tom can still manage all of them.
      allow create: if isTeacher() && request.resource.data.teacherUid == me();
      allow update, delete: if isMaster() || (isTeacher() && myClassroom());

      match /members/{memberUid} {
        // Rosters are teacher-only (Phase 3): the class's teacher, Tom, and each student's own entry.
        allow read: if signedIn() && (me() == memberUid || isMaster() || teachesThis());
        // Students add or remove themselves; the class's teacher (and Tom) can remove anyone.
        allow create, update: if signedIn() && me() == memberUid;
        allow delete: if signedIn() && (me() == memberUid || isMaster() || teachesThis());
      }

      // Projects students share with their class (Phase 3). Replaces reading the roster
      // to find classmates' shared projects.
      match /shared/{entryId} {
        allow read: if signedIn() && (inThis() || isMaster() || teachesThis());
        allow create, update: if signedIn() && inThis()
          && request.resource.data.ownerUid == me()
          && entryId == me() + '_' + request.resource.data.projectId;
        allow delete: if signedIn() && (resource.data.ownerUid == me() || isMaster() || teachesThis());
      }
    }

    // ── Comments: a teacher's feedback on a student's work ───────
    match /comments/{commentId} {
      allow read, write: if isMaster();
      // The student's class teacher (Phase 3): read, write their own comments.
      allow read: if teachesStudent(resource.data.studentUid);
      allow create: if request.resource.data.authorUid == me() && teachesStudent(request.resource.data.studentUid);
      allow update, delete: if resource.data.authorUid == me() && teachesStudent(resource.data.studentUid);
      // Students can read comments on their own workspace and mark them as read.
      allow read, update: if signedIn() && me() == resource.data.studentUid;

      match /replies/{replyId} {
        function studentOf() { return get(/databases/$(database)/documents/comments/$(commentId)).data.studentUid; }
        allow read, write: if isMaster();
        allow read, create: if teachesStudent(studentOf());
        // Students can read and post replies on their own comments.
        allow read, create: if signedIn() && me() == studentOf();
      }
    }

    // ── Comment templates: a teacher's saved feedback snippets ───
    match /commentTemplates/{id} {
      allow read, update, delete: if signedIn() && resource.data.authorUid == me();
      allow create: if isTeacher() && request.resource.data.authorUid == me();
    }

    // ── Teacher tips: shown to students inside the tools ─────────
    match /teacherTips/{id} {
      // Students load every tip and the app picks the ones meant for them.
      allow read: if signedIn();
      allow create: if isTeacher() && request.resource.data.authorUid == me();
      allow update, delete: if signedIn() && resource.data.authorUid == me();
    }
  }
}
